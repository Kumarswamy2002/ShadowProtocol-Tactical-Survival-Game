# Shadow Protocol Environment Configuration Example
PROJECT_NAME="Shadow Protocol Backend Service"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# JWT Security
SECRET_KEY="replace-this-with-a-secure-random-jwt-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database
POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_shadow_pass"
POSTGRES_DB="shadow_protocol"
POSTGRES_PORT=5432
DATABASE_URL="postgresql+asyncpg://postgres:postgres_shadow_pass@localhost:5432/shadow_protocol"

# Redis Cache
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
